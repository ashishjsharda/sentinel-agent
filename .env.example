# ---- CockroachDB Cloud ----
# Get this from the CockroachDB Cloud console -> your cluster -> "Connect"
# Example: postgresql://<user>:<password>@<cluster-host>:26257/sentinel?sslmode=verify-full
DATABASE_URL=postgresql://user:password@free-tier.aws-us-east-1.cockroachlabs.cloud:26257/sentinel?sslmode=verify-full

# ---- CockroachDB Cloud Managed MCP Server ----
# https://cockroachlabs.cloud/mcp -- used by Claude Code / Cursor / VS Code during
# development to inspect the live memory store (read-only mode recommended).
# Generate a service-account API key in the Cloud Console under "MCP".
COCKROACHDB_MCP_API_KEY=changeme
COCKROACHDB_MCP_CLUSTER_ID=changeme

# ---- ccloud CLI (agent-ready control plane) ----
# `ccloud auth login` will populate a token; these are only needed for
# non-interactive / CI usage (see deploy/deploy.sh).
CCLOUD_API_KEY=changeme

# ---- AWS ----
AWS_REGION=us-east-1
# Bedrock model IDs (adjust to whatever is enabled in your account)
BEDROCK_REASONING_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# S3 bucket for diagnosis reports / artifacts
SENTINEL_S3_BUCKET=sentinel-agent-artifacts

# ---- App ----
SENTINEL_VECTOR_DIM=1024
LOG_LEVEL=INFO
